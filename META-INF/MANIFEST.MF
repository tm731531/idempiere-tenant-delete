Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: iDempiere Client Initialize Plugin
Bundle-SymbolicName: tw.idempiere.clientinit;singleton:=true
Bundle-Version: 12.0.0.qualifier
Bundle-Activator: tw.idempiere.clientinit.Activator
Bundle-Vendor: iDempiere Community
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: org.adempiere.base;bundle-version="12.0.0",
 org.adempiere.plugin.utils;bundle-version="12.0.0"
Import-Package: org.osgi.framework;version="1.3.0"
Export-Package: tw.idempiere.clientinit,
 tw.idempiere.clientinit.cleanup,
 tw.idempiere.clientinit.data,
 tw.idempiere.clientinit.process,
 tw.idempiere.clientinit.util
Bundle-ActivationPolicy: lazy
Service-Component: OSGI-INF/component.xml,
 OSGI-INF/ProcessFactory.xml
